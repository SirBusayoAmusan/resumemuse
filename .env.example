# ---- Optional owner fallback key ----
# Normally each visitor brings their own Groq key (BYOK), sent per-request and
# never stored. This env key is only a fallback so YOU can test without pasting
# one in the browser. Leave it blank in production.
GROQ_API_KEY=

# ---- Model (optional) ----
# Groq deprecates models often. If you get a 404 from the API, put the current
# production model name here instead of touching the code.
GROQ_MODEL=openai/gpt-oss-120b

# ---- Durable rate limiting (optional but recommended in production) ----
# Create a free Redis database at upstash.com and paste its REST URL and token.
# Without these, rate limiting falls back to per-instance in-memory counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Rate limit tuning (optional) ----
# Anonymous free traffic. Raise once you add accounts/payment.
RATE_LIMIT_BURST=4
RATE_LIMIT_HOURLY=20
